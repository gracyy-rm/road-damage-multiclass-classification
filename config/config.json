{
    "paths": {
        "train_csv": "",
        "val_csv": "",
        "test_csv": "",
        "experiments_dir": "experiments/"
    },

    "model": {
        "architecture": "resnet18",
        "pretrained": true,
        "num_classes": 5,
        "freeze_backbone": "partial"
    },

    "classes": {
        "mapping": {
            "0": "Major Damage",
            "1": "Manhole",
            "2": "Minor Damage",
            "3": "Normal Road",
            "4": "Speed Breaker"
        }
    },

    "training_parameters": {
        "batch_size": 32,
        "learning_rate": 0.001,
        "epochs": 25,
        "image_size": 224,
        "seed": 1,
        "accumulation_steps": 2,
        "early_stopping_patience": 8,
        "weight_decay": 0.05
    },

    "hardware": {
        "num_workers": 4
    }

}